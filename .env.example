# Copy to .env. Everything here has a working default: with no .env at all the
# engine runs its deterministic offline arms and the full eval suite passes.

# ---------------------------------------------------------------- language model
# Unset -> offline mode (heuristic decomposition, extractive synthesis).
# Set    -> the graded path: one decomposition call and one synthesis call per turn.
OPENAI_API_KEY=
SLR_LLM=auto                  # auto | openai | offline
SLR_LLM_MODEL=gpt-4o-mini
SLR_DECOMPOSE_MODEL=gpt-4.1     # splits the utterance; empty = SLR_LLM_MODEL
# SLR_LLM_BASE_URL=           # any OpenAI-compatible endpoint

# ---------------------------------------------------------------- corpus
SLR_CORPUS_DIR=./evals/corpora/enterprise
SLR_INDEX_DIR=./data/index
SLR_TRACE_PATH=./data/traces/trace.jsonl
# SLR_OTEL_ENDPOINT=http://localhost:4318   # OTLP/HTTP collector; unset = span export off

# ---------------------------------------------------------------- local models
SLR_EMBEDDER=auto             # auto | bge | lsa  (lsa needs no download)
SLR_EMBED_MODEL=BAAI/bge-small-en-v1.5
SLR_RERANKER=auto             # auto | cross | none
SLR_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SLR_VERIFIER=auto             # auto | nli | lexical
SLR_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall

# ---------------------------------------------------------------- ablation knobs
SLR_CONTROLLER=rule           # rule | model | batch (baseline)
SLR_BRANCHES=bm25,dense       # dense | bm25 | bm25,dense
SLR_QUOTA_PER_INTENT=2        # 0 disables the per-intent coverage guarantee

# ---------------------------------------------------------------- thresholds
SLR_TAU_STAB=0.95             # prefix-embedding cosine that counts as "meaning settled"
SLR_STAB_RUN=2                # consecutive stable chunks before a provisional search
SLR_TAU_SHIFT=0.70            # below this, the utterance changed topic: cancel
SLR_TAU_REFINE=0.60           # similarity to the previous request for a late constraint
SLR_TOP_K=8                   # chunks in the answer context
SLR_SUPPORT_MIN=0.5           # below this a claim is demoted into uncertainty
SLR_AUTO_CITE_MIN=0.75        # bar for a citation the engine picks itself

# ---------------------------------------------------------------- cost reporting
SLR_PRICE_IN_PER_M=0.15
SLR_PRICE_OUT_PER_M=0.60
SLR_CPU_USD_PER_HOUR=0.05     # local inference is priced too, so cost/turn is honest
